# ============================================================
# ForgeSites AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated origins, or * for development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# Anon / public key (safe to use on the client side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — server-side only, never expose to clients
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Cost-efficient default. Use gpt-4o for higher quality.
OPENAI_MODEL=gpt-4o-mini

# ─── Vercel ───────────────────────────────────────────────────────────────────
# Get token: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Only required for Vercel Teams accounts
VERCEL_TEAM_ID=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Live key: sk_live_... | Test key: sk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# ─── Domain Provider ──────────────────────────────────────────────────────────
# Supported: namecheap | cloudflare
DOMAIN_PROVIDER=namecheap

# Namecheap (used when DOMAIN_PROVIDER=namecheap)
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=
# Your server's public IP (required by Namecheap API whitelist)
NAMECHEAP_CLIENT_IP=0.0.0.0

# Cloudflare (used when DOMAIN_PROVIDER=cloudflare)
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Window in milliseconds (default: 900000 = 15 min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (global)
RATE_LIMIT_MAX=100
# Max auth attempts per window per IP
AUTH_RATE_MAX=10
# Max AI generations per hour per user
AI_RATE_MAX=20
# Max publishes per hour per user
PUBLISH_RATE_MAX=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ─── Legacy Pipeline (v2 — optional) ─────────────────────────────────────────
# Only needed for the batch lead pipeline (npm start / npm run worker)
REDIS_URL=redis://127.0.0.1:6379
MIN_PRIORITY=medium
PROCESS_ALL_LEADS=false
DELAY_MS=1500
CONCURRENCY=3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
